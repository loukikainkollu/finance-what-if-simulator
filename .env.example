# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Backend / FastAPI
# SQLAlchemy async URL for Postgres (used by backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance_helper

# CORS origins (comma-separated). For local dev, frontend at 3000
CORS_ORIGINS=http://localhost:3000

# Flexprice billing (set real keys in production)
FLEXPRICE_API_KEY=
FLEXPRICE_ACCOUNT_ID=

# Pathway (if required by your account)
PATHWAY_API_KEY=