# Backend environment variables (.env)
# Copy this file to backend/.env and adjust values

# Database connection (SQLAlchemy sync or async URL)
# For async with asyncpg:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/finance_helper
# Or for sync driver if your code uses sync engine:
# DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/finance_helper

# Flexprice billing credentials
FLEXPRICE_API_KEY=replace-with-your-flexprice-key
FLEXPRICE_ACCOUNT_ID=replace-with-your-flexprice-account-id

# Pathway credentials / config
PATHWAY_API_KEY=replace-with-your-pathway-key
PATHWAY_STREAM_URL=https://api.pathway.example/live

# CORS origins (comma separated, e.g., http://localhost:3000,http://frontend:3000)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# App host/port (overridable in compose)
HOST=0.0.0.0
PORT=8000