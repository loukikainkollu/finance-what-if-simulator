# Deployment environment variables
# Copy to .env.deploy and fill in real values before running production/staging stacks

# Your apex/root domain for production (e.g., example.com)
DOMAIN=example.com

# Email for Let's Encrypt registration and renewal notices
LETSENCRYPT_EMAIL=admin@example.com

# Optional: For staging stack, set a staging subdomain here (or override DOMAIN when running)
# DOMAIN=staging.example.com